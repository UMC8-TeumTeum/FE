<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tutorialOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_scrim" />

    <FrameLayout
        android:id="@+id/spotlightGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="203dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/sample_timetable_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/sample_timetable_sv"/>

    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/btnCloseTutorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="66dp"
            android:layout_marginStart="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_close_sv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/labelTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="152dp"
            android:layout_marginTop="50dp"
            android:fontFamily="@font/noto_sans_kr_regular"
            android:includeFontPadding="false"
            android:lineSpacingExtra="-2dp"
            android:text="일정과 수면패턴이 \n겹칠 경우 반투명으로"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnCloseTutorial" />

        <TextView
            android:id="@+id/labelRightTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:layout_marginEnd="22dp"
            android:fontFamily="@font/noto_sans_kr_regular"
            android:includeFontPadding="false"
            android:lineSpacingExtra="-2dp"
            android:text="수면 패턴은\n좀 더 진하게"
            android:textAlignment="textEnd"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnCloseTutorial" />

        <TextView
            android:id="@+id/labelLeftTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:layout_marginStart="22dp"
            android:fontFamily="@font/noto_sans_kr_regular"
            android:includeFontPadding="false"
            android:lineSpacingExtra="-2dp"
            android:text="오늘의 일정은 \n보라색으로"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnCloseTutorial" />

        <TextView
            android:id="@+id/labelLeftBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="24dp"
            android:layout_marginTop="375dp"
            android:fontFamily="@font/noto_sans_kr_regular"
            android:includeFontPadding="false"
            android:text="빈틈은 하얗게"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnCloseTutorial" />

        <TextView
            android:id="@+id/labelBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="473dp"
            android:layout_marginEnd="23dp"
            android:fontFamily="@font/noto_sans_kr_regular"
            android:text="오전과 오후 변경"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.example.teumteum.ui.main.DashCurveView
            android:id="@+id/dashRightTop"
            android:layout_width="62dp"
            android:layout_height="63dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="35dp"
            app:viewportWidth="62"
            app:viewportHeight="63"
            app:pathData="M0.017,61.953C25.09,62.652 61.017,56.245 61.017,0"
            app:strokeWidth="1.2dp"
            app:strokeColor="#D3D3D3"
            app:strokeAlpha="0.8"
            app:dashLength="3dp"
            app:dashGap="4dp"
            app:layout_constraintEnd_toEndOf="@id/labelRightTop"
            app:layout_constraintTop_toBottomOf="@id/labelRightTop"/>

        <com.example.teumteum.ui.main.DashCurveView
            android:id="@+id/dashTop"
            android:layout_width="2dp"
            android:layout_height="100dp"
            android:layout_marginTop="15dp"
            app:viewportWidth="2"
            app:viewportHeight="100"
            app:pathData="M0.6,0C0.6,0 0.6,7 0.6,83.4"
            app:strokeWidth="1.2dp"
            app:strokeColor="#D3D3D3"
            app:strokeAlpha="0.8"
            app:dashLength="3dp"
            app:dashGap="4dp"
            app:layout_constraintStart_toStartOf="@id/labelTop"
            app:layout_constraintEnd_toEndOf="@id/labelTop"
            app:layout_constraintTop_toBottomOf="@id/labelTop" />

        <com.example.teumteum.ui.main.DashCurveView
            android:id="@+id/dashLeftTop"
            android:layout_width="62dp"
            android:layout_height="63dp"
            android:layout_marginStart="35dp"
            android:layout_marginTop="15dp"
            app:viewportWidth="62"
            app:viewportHeight="63"
            app:pathData="M61.6,61.953C36.527,62.652 0.6,56.245 0.6,0"
            app:strokeWidth="1.2dp"
            app:strokeColor="#D3D3D3"
            app:strokeAlpha="0.8"
            app:dashLength="3dp"
            app:dashGap="4dp"
            app:layout_constraintStart_toStartOf="@id/labelLeftTop"
            app:layout_constraintTop_toBottomOf="@id/labelLeftTop"/>

        <com.example.teumteum.ui.main.DashCurveView
            android:id="@+id/dashLeftBottom"
            android:layout_width="60dp"
            android:layout_height="59dp"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="5dp"
            app:viewportWidth="60"
            app:viewportHeight="59"
            app:pathData="M59.6,0.6C38.876,0.936 0.6,14.722 0.6,58.6"
            app:strokeWidth="1.2dp"
            app:strokeColor="#D3D3D3"
            app:strokeAlpha="0.8"
            app:dashLength="3dp"
            app:dashGap="4dp"
            app:layout_constraintStart_toStartOf="@id/labelLeftBottom"
            app:layout_constraintBottom_toTopOf="@id/labelLeftBottom"/>

        <com.example.teumteum.ui.main.DashCurveView
            android:id="@+id/dashRightBottom"
            android:layout_width="30dp"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="10dp"
            app:viewportWidth="30"
            app:viewportHeight="2"
            app:pathData="M0,0.6C0,0.6 7,0.6 38.104,0.6"
            app:strokeWidth="1.2dp"
            app:strokeColor="#D3D3D3"
            app:strokeAlpha="0.8"
            app:dashLength="3dp"
            app:dashGap="4dp"
            app:layout_constraintEnd_toStartOf="@id/labelBottom"
            app:layout_constraintTop_toTopOf="@id/labelBottom"/>

        <LinearLayout
            android:id="@+id/hintCalendar"
            android:layout_width="match_parent"
            android:layout_height="165dp"
            android:layout_marginStart="17dp"
            android:layout_marginTop="550dp"
            android:layout_marginEnd="17dp"
            android:background="@drawable/bg_hint_card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/labelCalendar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="캘린더에서\n날짜별 기록 확인"
                android:textAlignment="textEnd"
                android:textColor="@color/white"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/hintTodo"
            android:layout_width="match_parent"
            android:layout_height="500dp"
            android:layout_marginStart="17dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="17dp"
            android:background="@drawable/bg_hint_card"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hintCalendar">

            <TextView
                android:id="@+id/labelTodoList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="투두리스트에서\n등록한 일정 확인"
                android:textAlignment="textEnd"
                android:textColor="@color/white"
                android:textSize="15sp" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>