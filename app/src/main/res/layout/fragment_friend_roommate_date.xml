<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 뒤로가기 버튼 -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_arrow_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="뒤로가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/profile_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20.5dp"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 날짜 선택 텍스트 -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/noto_sans_kr_medium"
            android:text="날짜를 선택해주세요"
            android:includeFontPadding="false"
            android:textColor="#0F0F0F"
            android:textSize="16sp"
            android:layout_marginBottom="18dp" />

        <!-- 프로필 두 명 수평 정렬 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 왼쪽 유저 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="10dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profile_iv1"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@color/gray"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

                <TextView
                    android:id="@+id/profile_nickname_tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/noto_sans_kr_medium"
                    android:includeFontPadding="false"
                    android:text="문혜원"
                    android:textColor="#0F0F0F"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 가운데 점 4개 -->
            <LinearLayout
                android:id="@+id/dot_connector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="-10dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- 점 4개, 간격 8dp -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot_circle_gray" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot_circle_gray" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot_circle_gray" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@drawable/dot_circle_gray" />
            </LinearLayout>

            <!-- 오른쪽 유저 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="10dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profile_iv2"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@color/gray"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

                <TextView
                    android:id="@+id/profile_nickname_tv2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/noto_sans_kr_medium"
                    android:includeFontPadding="false"
                    android:text="나"
                    android:textColor="#0F0F0F"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 캘린더 헤더 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/calendarHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/profile_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/home_selected_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:layout_marginStart="32dp"
            android:text="2025년 6월"
            android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/home_calendar_previous_date_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="163dp"
            android:layout_marginEnd="18dp"
            android:src="@drawable/previous"
            app:layout_constraintTop_toTopOf="@id/home_selected_date_tv"
            app:layout_constraintStart_toEndOf="@id/home_selected_date_tv"
            app:layout_constraintEnd_toStartOf="@id/home_calendar_next_date_iv" />

        <ImageView
            android:id="@+id/home_calendar_next_date_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="42dp"
            android:src="@drawable/next"
            app:layout_constraintTop_toTopOf="@id/home_selected_date_tv"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/home_weekly_calendar_day_of_month_ll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="28dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="26dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/home_selected_date_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView style="@style/day_of_week_tv" android:text="일" />
            <TextView style="@style/day_of_week_tv" android:text="월" />
            <TextView style="@style/day_of_week_tv" android:text="화" />
            <TextView style="@style/day_of_week_tv" android:text="수" />
            <TextView style="@style/day_of_week_tv" android:text="목" />
            <TextView style="@style/day_of_week_tv" android:text="금" />
            <TextView style="@style/day_of_week_tv" android:text="토" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 캘린더 영역 -->
    <FrameLayout
        android:id="@+id/calendar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="180dp"
        app:layout_constraintBottom_toTopOf="@+id/next_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calendarHeaderLayout" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next_btn"
        style="@style/Md16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="19dp"
        android:layout_marginEnd="19dp"
        android:layout_marginBottom="19dp"
        android:backgroundTint="#F6F6F6"
        android:text="다음"
        android:textColor="#0F0F0F"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>