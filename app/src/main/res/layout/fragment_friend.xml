<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_friend_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:background="@color/main_1">

        <ImageView
            android:id="@+id/home_background_iv"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="146dp"
            android:layout_marginRight="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_home"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/home_logo_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="68dp"
            android:src="@drawable/friend_teumteum_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/home_logo_iv"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="59dp"
            android:background="@color/transparent"
            android:src="@drawable/ic_top_alarm"
            app:layout_constraintBaseline_toBaselineOf="@id/home_logo_iv" />

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/home_logo_iv"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="19dp"
            android:background="@color/transparent"
            android:src="@drawable/ic_search"
            app:layout_constraintBaseline_toBaselineOf="@id/home_logo_iv"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/textName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/home_logo_iv"
            android:layout_marginStart="24dp"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/noto_sans_kr_semibold"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:text="나와 하루의 빈틈이 맞는\n친구를 찾아볼까요?"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/emptyTeumRequestLayout"
            android:layout_width="match_parent"
            android:layout_height="163dp"
            android:layout_marginTop="185dp"
            android:layout_marginStart="21dp"
            android:layout_marginEnd="19dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#A6FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_teum_icon"
                    android:layout_width="130dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="116dp"
                    android:layout_marginEnd="104dp"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/purple_teum"
                    android:contentDescription="틈 없음 아이콘" />

                <TextView
                    android:id="@+id/tv_teum_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="새로운 틈 요청이 없어요"
                    android:includeFontPadding="false"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="31dp"
                    android:fontFamily="@font/noto_sans_kr_medium"
                    android:layout_gravity="center_horizontal" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recommendRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="185dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="21dp"
            android:paddingEnd="21dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/friend01_item_recommend_card"
            tools:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewPromiseBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="21dp"
            android:layout_marginEnd="19dp"
            android:layout_marginBottom="26dp"
            android:fontFamily="@font/noto_sans_kr_medium"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="약속된 틈 보러가기"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/text_primary"
            app:cornerRadius="12dp" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/tabFollowing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="팔로잉"
            android:fontFamily="@font/noto_sans_kr_medium"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/tabFollower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="팔로워"
            android:fontFamily="@font/noto_sans_kr_medium"
            android:textColor="@color/teumteum_deactive" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/followingRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:padding="12dp"
        tools:listitem="@layout/friend01_item_following" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/followerRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:padding="12dp"
        android:visibility="gone"
        tools:listitem="@layout/friend01_item_follower" />

</LinearLayout>
