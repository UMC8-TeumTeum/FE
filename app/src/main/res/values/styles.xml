<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="day_of_week_tv">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAlignment">center</item>
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="calendar_date_layout">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="calendar_date_tv">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/noto_sans_kr_regular</item>
    </style>

    <style name="TopRoundedCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">15dp</item>
        <item name="cornerSizeTopRight">15dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="category_toggle">
        <item name="android:thumb">@drawable/style_toggle_thumb</item>
        <item name="track">@drawable/style_toggle_btn</item>
        <item name="thumbTint">@null</item>
        <item name="android:enabled">true</item>
    </style>

    <style name="RoundedAlertDialog">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    // 달력
    <style name="CalendarOnlyTheme">
        <item name="colorControlActivated">@color/main_1</item>
    </style>

    // 타임피커
    <style name="CustomNumberPicker">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">155dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="CardCutTopLeft" parent="">
        <item name="cornerFamilyTopLeft">cut</item>
        <item name="cornerSizeTopLeft">30dp</item>

        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerSizeTopRight">15dp</item>

        <item name="cornerFamilyBottomLeft">rounded</item>
        <item name="cornerSizeBottomLeft">15dp</item>

        <item name="cornerFamilyBottomRight">rounded</item>
        <item name="cornerSizeBottomRight">15dp</item>
    </style>

</resources>